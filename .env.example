# GitHub API Token (Optional, but recommended for higher rate limits)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Baidu Qianfan LLM API Token (Required for AI analysis)
# Get from: https://qianfan.baidubce.com
QIANFAN_TOKEN=

# Ruliu (如流) Access Token (Required for notifications)
RULIU_ACCESS_TOKEN=

# Ruliu Target IDs (Required for notifications)
# Format: JSON array, e.g., [123456789, 987654321]
RULIU_TARGET_IDS=[]
